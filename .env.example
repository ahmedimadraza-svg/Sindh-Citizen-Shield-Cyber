# ==============================================================================
# SINDH CYBER SAATHI - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and insert your API keys before starting the server.
# NEVER commit your actual .env file or real API keys to GitHub!
# ==============================================================================

# 1. Google Gemini API Key (Required for AI Chat Counselor and Screenshot OCR Analysis)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# 2. Google Safe Browsing API v4 Key (Optional but recommended for live threat checks)
# Get a free key from Google Cloud Console (APIs & Services -> Safe Browsing API)
# Provides up to 10,000 free queries per day for non-commercial civic defense.
SAFE_BROWSING_API_KEY=""

# 3. Server Port (Default is 3000)
PORT="3000"

# 4. Optional custom Chromium path (for Docker, Linux, or custom VPS environments)
# CHROMIUM_PATH="/usr/bin/chromium"
